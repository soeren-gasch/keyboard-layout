{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(curl -s https://oryx.zsa.io/graphql:*)",
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "WebFetch(domain:oryx.zsa.io)",
      "WebFetch(domain:configure.zsa.io)",
      "WebFetch(domain:docs.qmk.fm)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
